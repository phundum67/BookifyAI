{
  "expo": {
    "name": "Bookify AI",
    "slug": "bookify-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/booklify-logo.png",
    "userInterfaceStyle": "light",
    "scheme": "bookifyai",
    "splash": {
      "image": "./assets/booklify-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#111111"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.bookifyai.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/booklify-logo.png",
        "backgroundColor": "#111111"
      },
      "permissions": [
        "INTERNET"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Bookify AI to choose a business cover image."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-video",
      "expo-asset"
    ],
    "extra": {
      "apiBaseUrl": "https://phundum67.pythonanywhere.com/api"
    }
  }
}
